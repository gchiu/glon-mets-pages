[
clampv: func [v] [ either > v 8000 [ 8000 ] [ either < v -8000 [ -8000 ] [ v ] ] ]
sq: func [v] [ * v v ]
d2: func [ax ay bx by] [ + sq clampv - ax bx sq clampv - ay by ]
dist: func [ax ay bx by] [ isq d2 ax ay bx by ]
jt-n: 0
jw: new-block 35
jw-clear: func [i] [ either < i 7 [ block-set! jw * 5 i -1  jw-clear + i 1 ] [ none ] ]
jw-slot: func [k i] [ either < i 7 [ either = block-at jw * 5 i k [ i ] [ jw-slot k + i 1 ] ] [ -1 ] ]
jw-base: func [] [ either = j-st 'ON_BUS [ - j-next 1 ] [ either = j-st 'WALKING_FINAL [ - j-next 1 ] [ j-board ] ] ]
jw-want: func [k] [
    either = j-g 1 [ 1 ] [ either = k j-board [ 1 ] [ either = k j-alight [ 1 ] [
        wb: jw-base
        either < k wb [ 0 ] [ < k + wb 5 ]
    ] ] ]
]
jw-free: func [i] [
    either < i 7 [
        wk: block-at jw * 5 i
        either < wk 0 [ i ] [ either jw-want wk [ jw-free + i 1 ] [ i ] ]
    ] [ -1 ]
]
jw-put: func [k s t x y] [
    ws: jw-slot k 0
    either < ws 0 [ ws: jw-free 0 ] [ none ]
    either < ws 0 [ none ] [
        wo: * 5 ws
        block-set! jw wo k
        block-set! jw + wo 1 s
        block-set! jw + wo 2 t
        block-set! jw + wo 3 x
        block-set! jw + wo 4 y
    ]
]
jw-has: func [k] [ >= jw-slot k 0 0 ]
sv: func [k f] [
    ws: jw-slot k 0
    either < ws 0 [ 0 ] [ block-at jw + + * 5 ws f 1 ]
]
f-ms: -1
f-ml: -1
mt-s: 0
mt-lat: 0
match: func [] [ mt-s: f-ms  mt-lat: f-ml ]
off-at: func [k s] [
    either >= k - jt-n 1 [ sv - jt-n 1 1 ] [
        s0: sv k 0  s1: sv + k 1 0
        o0: sv k 1  o1: sv + k 1 1
        either <= s s0 [ o0 ] [
            either >= s s1 [ o1 ] [ + o0 / * - o1 o0 - s s0 either > - s1 s0 0 [ - s1 s0 ] [ 1 ] ]
        ]
    ]
]
jw-clear 0
]
