[
events: [
    ['boot [ render ]]
    ['fix [
        ev-parse current-value
        f-x: ev 0  f-y: ev 1  f-acc: ev 2  f-ms: ev 3  f-ml: ev 4  f-have: 1
        refresh-geom
        fix-update
        render ]]
    ['clock [
        ev-parse current-value
        j-now: ev 0  j-date: ev 1  j-wday: ev 2
        time-update
        render ]]
    ['rt-lost [ rt-ok: 0  cq-rt-off cq-cl 6 5 0 - cn 3 1  cq-rt-off cq-tr 8 6 0 - cn 2 1  time-update  render ]]
    ['choose [ ev-parse current-value  choose ev 0  render ]]
    ['pax [ ev-parse current-value
        pf-conc: either < ev 0 block-len fare-types [ block-at fare-types ev 0 ] [ block-at fare-types 0 ]
        eval-fare  render ]]
    ['dest-at [ ev-parse current-value  either < ev 0 dest-n [
        block-set! dest-row * 3 ev 0 1  block-set! dest-row + * 3 ev 0 1 ev 1  block-set! dest-row + * 3 ev 0 2 ev 2
    ] [ none ]  render ]]
    ['accept [ accept  render ]]
    ['board [ board-cmd  render ]]
    ['alight [ alight-cmd  render ]]
    ['where [ j-where: 1  render ]]
    ['where-close [ j-where: 0  render ]]
    ['cancel [ reset-journey  render ]]
    ['done [ reset-journey  render ]]
    ['cq-begin [ ev-parse current-value  cq-reset ev 0 ev 1  render ]]
    ['cq-stop [ ev-parse current-value  cq-add cq-st 0 2 3 40  render ]]
    ['cq-dst [ ev-parse current-value  cq-add cq-ds 1 2 3 24  render ]]
    ['cq-trip [ ev-parse current-value  cq-add cq-tr 2 5 8 24  render ]]
    ['cq-call [ ev-parse current-value  cq-add cq-cl 3 4 6 64  render ]]
    ['cq-arr [ ev-parse current-value  cq-add cq-ar 4 3 3 48  render ]]
    ['cq-end [ ev-parse current-value  either = ev 0 cn 5 [ block-set! cq-n 6 1  on-candidates ] [ none ]  render ]]
    ['cq-rt [ ev-parse current-value  cq-rt ev 0 ev 1 ev 2  render ]]
    ['cq-rt-end [ ev-parse current-value  rt-ok: 1  rt-t: ev 0  cs-resel  time-update  render ]]
    ['cq-score [ cs-score  render ]]
    ['jw [ ev-parse current-value  jw-put ev 0 ev 1 ev 2 ev 3 ev 4  render ]]
    ['jt [ ev-parse current-value  on-trip-ready ev 0 ev 1 ev 2 ev 3  render ]]
]
do-event: [
    event-row: select events current-event
    either event-row [ do block-at event-row 1 ] [ render ]
]
route: [ render ]
]
