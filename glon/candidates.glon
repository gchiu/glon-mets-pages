[
cq-st: new-block 160
cq-ds: new-block 72
cq-tr: new-block 192
cq-cl: new-block 448
cq-ar: new-block 192
cq-n: new-block 16
cq-best: new-block 4
cq-alt: new-block 136
cn: func [k] [ block-at cq-n k ]
cl: func [i f] [ block-at cq-cl + * 7 i f ]
tr: func [i f] [ block-at cq-tr + * 8 i f ]
al: func [i f] [ block-at cq-alt + * 17 i f ]
cq-fill: func [b i n v] [ either < i n [ block-set! b i v  cq-fill b + i 1 n v ] [ none ] ]
cq-rows: func [s tb k w cap] [
    n: cn k
    n: + n / - ev-pack s tb * n w * n w w
    either > n cap [ block-set! cq-n k cap  block-set! cq-n 7 1 ] [ block-set! cq-n k n ]
]
cq-rt: func [i d ob pg] [
    either pg [
        either < i cn 3 [
            t: cl i 0
            either < ob 0 [
                block-set! cq-cl + * 7 i 6 0
                either = tr t 7 i [ block-set! cq-tr + * 8 t 6 0 ] [ none ]
            ] [
                block-set! cq-cl + * 7 i 5 d
                block-set! cq-cl + * 7 i 6 + ob 1
                block-set! cq-tr + * 8 t 5 d
                block-set! cq-tr + * 8 t 6 + ob 1
                block-set! cq-tr + * 8 t 7 i
            ]
        ] [ none ]
    ] [
        either < i cn 12 [
            either < ob 0 [
                block-set! cq-alt + * 17 i 13 0
                al-trip al i 1 0 -1 i 0 cn 12
            ] [
                block-set! cq-alt + * 17 i 12 d
                block-set! cq-alt + * 17 i 13 + ob 1
                al-trip al i 1 d + ob 1 i 0 cn 12
            ]
        ] [ none ]
    ]
]
al-trip: func [t d sn src i n] [
    either < i n [
        either = al i 1 t [
            either < sn 0 [
                either = al i 16 src [ block-set! cq-alt + * 17 i 15 0 ] [ none ]
            ] [
                block-set! cq-alt + * 17 i 14 d
                block-set! cq-alt + * 17 i 15 sn
                block-set! cq-alt + * 17 i 16 src
            ]
        ] [ none ]
        al-trip t d sn src + i 1 n
    ] [ none ]
]
cq-rt-off: func [tb w f a b] [
    either >= a b [ either = a b [ block-set! tb + * w a f 0 ] [ none ] ] [
        m: / + a b 2
        cq-rt-off tb w f a m
        cq-rt-off tb w f + m 1 b
    ]
]
rt-fresh: func [sn] [
    either = sn 0 [ 0 ] [
        ag: - j-now - sn 1
        either > ag c 'rt-stale-s [ 0 ] [ >= ag -60 ]
    ]
]
cq-d: func [i] [
    either rt-fresh cl i 6 [ cl i 5 ] [ either rt-fresh tr cl i 0 6 [ tr cl i 0 5 ] [ 0 ] ]
]
alt-d: func [i] [
    either rt-fresh al i 13 [ al i 12 ] [ either rt-fresh al i 15 [ al i 14 ] [ 0 ] ]
]
pg-offer: func [a b] [
    either >= a b [
        ca: * 7 a
        tb: * 8 block-at cq-cl ca
        fa: block-at cq-tr + tb 2
        la: block-at cq-tr + tb 3
        ai: either < la fa [ -1 ] [
            k: cs-k a
            either cs-ok [ cs-best-arr block-at cq-cl + ca 2 fa la k ] [ -1 ]
        ]
        either < ai 0 [ none ] [
            n: cn 12
            k: block-at cs-w 13
            o: block-at cq-cl + ca 4
            p: either < n k [ al-pos cs-v o 0 n ] [
                q: * 17 - k 1
                either either < cs-v block-at cq-alt q [ 1 ] [ either = cs-v block-at cq-alt q [ < o block-at cq-alt + q 10 ] [ 0 ] ] [
                    al-pos cs-v o 0 n
                ] [ k ]
            ]
            either < p k [
                al-shift * 17 p  - * 17 either < n k [ n ] [ - k 1 ] 1
                q: * 17 p
                sa: * 4 block-at cq-cl + ca 1
                aa: * 4 ai
                da: * 3 block-at cq-ar aa
                block-set! cq-alt q cs-v
                block-set! cq-alt + q 1 block-at cq-tr + tb 4
                block-set! cq-alt + q 2 block-at cq-cl + ca 2
                block-set! cq-alt + q 3 block-at cq-cl + ca 3
                block-set! cq-alt + q 4 block-at cq-st sa
                block-set! cq-alt + q 5 block-at cq-st + sa 1
                block-set! cq-alt + q 6 block-at cq-ar + aa 1
                block-set! cq-alt + q 7 block-at cq-ar + aa 2
                block-set! cq-alt + q 8 block-at cq-ds da
                block-set! cq-alt + q 9 block-at cq-ds + da 1
                block-set! cq-alt + q 10 o
                block-set! cq-alt + q 11 block-at cq-ar + aa 3
                block-set! cq-alt + q 12 block-at cq-cl + ca 5
                block-set! cq-alt + q 13 block-at cq-cl + ca 6
                block-set! cq-alt + q 14 block-at cq-tr + tb 5
                block-set! cq-alt + q 15 block-at cq-tr + tb 6
                block-set! cq-alt + q 16 -1
                either < n k [ block-set! cq-n 12 + n 1 ] [ none ]
            ] [ none ]
        ]
    ] [
        m: / + a b 2
        pg-offer a m
        pg-offer + m 1 b
    ]
]
al-pos: func [v o i n] [
    either < i n [
        q: * 17 i
        either either < v block-at cq-alt q [ 1 ] [ either = v block-at cq-alt q [ < o block-at cq-alt + q 10 ] [ 0 ] ] [ i ] [ al-pos v o + i 1 n ]
    ] [ n ]
]
al-shift: func [a b] [
    either >= a b [ either = a b [ block-set! cq-alt + a 17 block-at cq-alt a ] [ none ] ] [
        m: / + a b 2
        al-shift + m 1 b
        al-shift a m
    ]
]
cq-fill cq-n 0 16 0
cq-fill cq-best 0 4 -1
]
