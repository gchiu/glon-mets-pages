[
cq-st: new-block 120
cq-ds: new-block 72
cq-tr: new-block 192
cq-cl: new-block 256
cq-ar: new-block 144
cq-n: new-block 8
cq-best: new-block 3
cn: func [k] [ block-at cq-n k ]
cl: func [i f] [ block-at cq-cl + * 4 i f ]
ar: func [i f] [ block-at cq-ar + * 3 i f ]
tr: func [i f] [ block-at cq-tr + * 8 i f ]
cst: func [i f] [ block-at cq-st + * 3 i f ]
cds: func [i f] [ block-at cq-ds + * 3 i f ]
cq-fill: func [b i n v] [ either < i n [ block-set! b i v  cq-fill b + i 1 n v ] [ none ] ]
cq-reset: func [gen trunc] [
    cq-fill cq-n 0 5 0
    block-set! cq-n 5 gen
    block-set! cq-n 6 0
    block-set! cq-n 7 trunc
    cq-fill cq-best 0 3 -1
]
cq-put: func [tb base i nf w] [
    either < i w [
        block-set! tb + base i either < i nf [ ev i ] [ 0 ]
        cq-put tb base + i 1 nf w
    ] [ none ]
]
cq-add: func [tb k nf w cap] [
    n: cn k
    either < n cap [ cq-put tb * n w 0 nf w  block-set! cq-n k + n 1 ] [ block-set! cq-n 7 1 ]
]
cq-rt: func [t d] [
    either < t cn 2 [ block-set! cq-tr + * 8 t 5 d  block-set! cq-tr + * 8 t 6 1 ] [ none ]
]
cq-rt-off: func [i n] [ either < i n [ block-set! cq-tr + * 8 i 6 0  cq-rt-off + i 1 n ] [ none ] ]
cs-walk: func [tb a b x y] [
    either >= a b [ block-set! tb + * 3 a 2 dist x y block-at tb * 3 a block-at tb + * 3 a 1 ] [
        m: / + a b 2
        cs-walk tb a m x y
        cs-walk tb + m 1 b x y
    ]
]
cs-w: new-block 12
cs-prep: func [] [
    block-set! cs-w 0 pf 'walk-mult
    block-set! cs-w 1 pf 'walk-comfort-m
    block-set! cs-w 2 pf 'walk-steep-mult
    block-set! cs-w 3 pf 'walk-tolerance-m
    block-set! cs-w 4 pf 'walk-over-mult
    block-set! cs-w 5 pf 'walk-max-m
    block-set! cs-w 6 pf 'wait-mult
    block-set! cs-w 7 pf 'ivt-mult
    block-set! cs-w 8 pf 'arrive-mult
    block-set! cs-w 9 pf 'buffer-s
    block-set! cs-w 10 pf 'walk-cms
    block-set! cs-w 11 either = j-st 'WALKING_TO_STOP [ 1 ] [ either = j-st 'WAITING_FOR_BUS [ 1 ] [ 0 ] ]
]
wc: func [m] [
    cm: block-at cs-w 1
    tl: block-at cs-w 3
    eq: either > m cm [
        either > m tl [
            + + cm * - tl cm block-at cs-w 2 * - m tl block-at cs-w 4
        ] [ + cm * - m cm block-at cs-w 2 ]
    ] [ m ]
    + either > m block-at cs-w 5 [ 1000000 ] [ 0 ]  * block-at cs-w 0 / * eq 100 block-at cs-w 10
]
cs-ok: 0
cs-cost: func [c a] [
    cs-ok: 0
    either > ar a 1 cl c 2 [
        t: cl c 0
        d: either tr t 6 [ tr t 5 ] [ 0 ]
        am: cst cl c 1 2
        wo: / * am 100 block-at cs-w 10
        et: - + cl c 3 d j-now
        either < et wo [ 0 ] [
            cs-ok: 1
            sl: - et wo
            pw: either block-at cs-w 11 [ sl ] [ either < sl block-at cs-w 9 [ sl ] [ block-at cs-w 9 ] ]
            em: cds ar a 0 2
            + + + + wc am  wc em
                * block-at cs-w 6 pw
                * block-at cs-w 7 - ar a 2 cl c 3
                * block-at cs-w 8 + - + ar a 2 d j-now  / * em 100 block-at cs-w 10
        ]
    ] [ 0 ]
]
cs-v: 0
cs-best-arr: func [c a b] [
    either >= a b [
        v: cs-cost c a
        either cs-ok [ cs-v: v  a ] [ -1 ]
    ] [
        m: / + a b 2
        i: cs-best-arr c a m
        vi: cs-v
        j: cs-best-arr c + m 1 b
        either < i 0 [ j ] [ either < j 0 [ cs-v: vi  i ] [ either < cs-v vi [ j ] [ cs-v: vi  i ] ] ]
    ]
]
cs-bv: 0
cs-ba: -1
cs-best-call: func [a b] [
    either >= a b [
        t: cl a 0
        ai: either < tr t 3 tr t 2 [ -1 ] [ cs-best-arr a tr t 2 tr t 3 ]
        either < ai 0 [ -1 ] [ cs-bv: cs-v  cs-ba: ai  a ]
    ] [
        m: / + a b 2
        i: cs-best-call a m
        vi: cs-bv  ai: cs-ba
        j: cs-best-call + m 1 b
        either < i 0 [ j ] [
            either < j 0 [ cs-bv: vi  cs-ba: ai  i ] [
                either < cs-bv vi [ j ] [ cs-bv: vi  cs-ba: ai  i ]
            ]
        ]
    ]
]
cs-score: func [] [
    cq-fill cq-best 0 3 -1
    either = cn 6 1 [
        either > cn 3 0 [
            cs-prep
            either > cn 0 0 [ cs-walk cq-st 0 - cn 0 1 f-x f-y ] [ none ]
            either > cn 1 0 [ cs-walk cq-ds 0 - cn 1 1 j-dx j-dy ] [ none ]
            bc: cs-best-call 0 - cn 3 1
            either < bc 0 [ none ] [
                block-set! cq-best 0 bc
                block-set! cq-best 1 cs-ba
                block-set! cq-best 2 cs-bv
            ]
        ] [ none ]
    ] [ none ]
]
cq-reset 0 0
]
