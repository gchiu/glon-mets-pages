[
j-st: 'IDLE
j-now: 0
j-date: 0
j-wday: 0
f-x: 0
f-y: 0
f-acc: 0
f-have: 0
j-dest: -1
j-dx: 0
j-dy: 0
j-walk: 0
j-board: -1
j-alight: -1
j-opt: -1
rt-ok: 0
rt-t: 0
m-s: 0
m-lat: 0
m-t: 0
a-s: 0
a-t: -1000
v-cms: 0
sp-fast: 0
sp-ride: 0
sp-walk: 0
al-d: 0
due-t: -100000
w-t: -100000
j-next: 0
press-t: -1
lat-n: 0
j-alert: 'NONE
j-leave: 'NONE
j-buzz: 0
j-where: 0
j-note: 0
j-q: 0
j-qgen: 0
j-rad: 0
j-trip: -1
j-bseq: -1
j-aseq: -1
j-g: 0
j-lnow: 0
c: func [k] [ block-at select cfg k 1 ]
pf: func [k] [ block-at select prefs k 1 ]
rt-live: func [] [ either rt-ok [ <= - j-now rt-t c 'rt-stale-s ] [ 0 ] ]
live-now: func [] [
    k: block-at cq-best 3
    either < k 0 [ 0 ] [ either = tr cl k 0 4 j-trip [
        either rt-fresh cl k 5 [ 1 ] [ rt-fresh tr cl k 0 6 ]
    ] [ 0 ] ]
]
board-time: func [] [ + sv j-board 1 either live-now [ cq-d block-at cq-best 3 ] [ 0 ] ]
eta: func [] [ - board-time j-now ]
walk-s: func [d] [ / * d 100 pf 'walk-cms ]
f-bm: 0
f-dm: 0
refresh-geom: func [] [
    f-bm: either >= j-board 0 [ dist f-x f-y sv j-board 2 sv j-board 3 ] [ 0 ]
    f-dm: either >= j-dest 0 [ dist f-x f-y j-dx j-dy ] [ 0 ]
]
to-board-m: func [] [ f-bm ]
to-dest-m: func [] [ f-dm ]
leave-s: func [] [ - - eta walk-s to-board-m pf 'buffer-s ]
ask-candidates: func [] [ j-q: 1  j-qgen: + j-qgen 1 ]
plan: func [] [
    either f-have [
        either = j-q 0 [
            either <= to-dest-m c 'walk-only-m [ walk-only ] [
                j-rad: either > pf 'walk-max-m c 'search-m [ pf 'walk-max-m ] [ c 'search-m ]
                ask-candidates
            ]
        ] [ none ]
    ] [ none ]
]
walk-only: func [] [
    j-walk: 1  j-opt: -1  j-q: 2
    j-st: 'JOURNEY_PROPOSED
    j-leave: 'WALK
    fare-eval j-now j-date j-wday
]
on-candidates: func [] [
    either = j-q 1 [
        either = cn 5 j-qgen [
            j-q: 2
            cs-score
            bc: block-at cq-best 0
            either < bc 0 [
                either < j-rad c 'search-max-m [
                    j-rad: * j-rad 2
                    ask-candidates
                ] [
                    j-opt: -1
                    either = j-st 'DESTINATION_SELECTED [ j-st: 'JOURNEY_PROPOSED ] [ none ]
                    j-leave: 'MISSED
                ]
            ] [
                ba: block-at cq-best 1
                either <= to-dest-m + cst cl bc 1 2 cds ar ba 0 2 [
                    either = j-st 'DESTINATION_SELECTED [ walk-only ] [ none ]
                ] [ cs-take bc ba ]
            ]
        ] [ none ]
    ] [ none ]
]
cs-take: func [bc ba] [
    t: cl bc 0
    j-trip: tr t 4
    j-bseq: cl bc 2
    j-aseq: ar ba 1
    j-g: 1
    block-set! cq-best 3 bc
    jw-clear 0
]
cs-resel: func [] [
    k: block-at cq-best 3
    st: j-st
    ok: either < k 0 [ 0 ] [ either = j-q 2 [ either j-g [ 0 ] [ either j-walk [ 0 ] [
        either = st 'JOURNEY_PROPOSED [ 1 ] [ either = st 'WALKING_TO_STOP [ 1 ] [ = st 'WAITING_FOR_BUS ] ]
    ] ] ] [ 0 ] ]
    either ok [
        cs-score
        bc: block-at cq-best 0
        either either < bc 0 [ 0 ] [ either = bc k [ 0 ] [ 1 ] ] [
            bv: block-at cq-best 2
            ba: block-at cq-best 1
            t: cl k 0
            ai: either < tr t 3 tr t 2 [ -1 ] [ cs-best-arr k tr t 2 tr t 3 ]
            either either < ai 0 [ 1 ] [ < + bv c 'rt-switch-cost cs-v ] [
                either = st 'WAITING_FOR_BUS [ either = cl bc 1 cl k 1 [ none ] [ j-st: 'WALKING_TO_STOP ] ] [ none ]
                j-note: 6
                cs-take bc ba
            ] [ none ]
        ] [ none ]
    ] [ none ]
]
on-trip-ready: func [no bk ak n] [
    either = j-g 1 [
        either = no j-trip [
            j-g: 0
            j-lnow: 0
            j-board: bk
            j-alight: ak
            jt-n: n
            j-opt: 1
            refresh-geom
            either = j-st 'DESTINATION_SELECTED [ j-st: 'JOURNEY_PROPOSED ] [ none ]
            pre-board
            eval-fare
        ] [ none ]
    ] [ none ]
]
eval-fare: func [] [
    fare-eval either > j-opt 0 [ board-time ] [ j-now ] j-date j-wday
]
pre-board: func [] [
    either j-walk [ j-leave: 'WALK ] [
        either = j-q 1 [ none ] [ either j-g [ none ] [
            either > j-opt 0 [
                gone: either = j-st 'WAITING_FOR_BUS [
                    < eta - 0 c 'missed-bus-s
                ] [ < eta walk-s to-board-m ]
                either gone [ j-note: 1  j-rad: either > pf 'walk-max-m c 'search-m [ pf 'walk-max-m ] [ c 'search-m ]  ask-candidates ] [ none ]
            ] [ none ]
        ] ]
        j-leave: either > j-opt 0 [
            either = j-q 1 [ 'MISSED ] [
                either = j-st 'WAITING_FOR_BUS [ 'WAIT ] [
                    either either j-lnow [ 0 ] [ > leave-s 0 ] [ 'LEAVE_IN ] [
                        either >= eta walk-s to-board-m [ j-lnow: 1  'LEAVE_NOW ] [ 'MISSED ]
                    ]
                ]
            ]
        ] [ either = j-q 1 [ 'NONE ] [ 'MISSED ] ]
    ]
]
track-speed: func [s] [
    dt: - j-now a-t
    either >= dt 4 [
        v-cms: / * - s a-s 100 dt
        a-s: s
        a-t: j-now
        sp-fast: either >= v-cms c 'board-cms [ either < sp-fast 99 [ + sp-fast 1 ] [ sp-fast ] ] [ 0 ]
        sp-ride: either >= v-cms c 'ride-cms [ either < sp-ride 99 [ + sp-ride 1 ] [ sp-ride ] ] [ 0 ]
        sp-walk: either < v-cms c 'ride-cms [
            either >= v-cms c 'dwell-cms [ either < sp-walk 99 [ + sp-walk 1 ] [ sp-walk ] ] [ 0 ]
        ] [ 0 ]
    ] [ none ]
]
board-detect: func [] [
    either > to-board-m 200 [ 0 ] [
        bs: sv j-board 0
        match
        track-speed mt-s
        either <= eta c 'board-due-s [ due-t: j-now ] [ none ]
        either > mt-s + bs c 'pass-m [ none ] [ w-t: j-now ]
        either > mt-s + bs c 'board-m [
            either < mt-lat c 'alight-lat-m [
                either <= - j-now due-t c 'board-due-s [
                    either >= sp-ride c 'ride-samples [ 1 ] [
                        either >= sp-ride 1 [ <= - j-now w-t c 'board-run-s ] [ 0 ]
                    ]
                ] [ 0 ]
            ] [ 0 ]
        ] [ 0 ]
    ]
]
walking-update: func [] [
    pre-board
    either board-detect [ enter-bus ] [
        either <= to-board-m + c 'near-stop-m / f-acc 2 [
            j-st: 'WAITING_FOR_BUS
            pre-board
        ] [ none ]
    ]
]
waiting-update: func [] [
    pre-board
    either board-detect [ enter-bus ] [ none ]
]
enter-bus: func [] [
    j-st: 'ON_BUS
    j-leave: 'NONE
    bs: sv j-board 0
    m-s: either > mt-s bs [ mt-s ] [ bs ]
    hist-fill m-s
    m-t: j-now
    m-lat: 0
    lat-n: 0
    al-d: 0
    j-next: + j-board 1
    press-t: -1
    adv-next
    bus-alert
]
adv-next: func [] [
    either < j-next jt-n [ either jw-has j-next [
        either >= m-s + sv j-next 0 c 'pass-m [ j-next: + j-next 1  adv-next ] [ none ]
    ] [ none ] ] [ none ]
]
m-hist: new-block 3
m-hk: 0
med3: func [a b d] [
    lo: either < a b [ a ] [ b ]
    hi: either < a b [ b ] [ a ]
    either < d lo [ lo ] [ either > d hi [ hi ] [ d ] ]
]
hist-fill: func [s] [ block-set! m-hist 0 s  block-set! m-hist 1 s  block-set! m-hist 2 s ]
bus-update: func [] [
    dt: - j-now m-t
    either < dt 1 [ dt: 1 ] [ none ]
    match
    either > dt 5 [ hist-fill mt-s ] [ block-set! m-hist m-hk mt-s ]
    m-hk: mod + m-hk 1 3
    cand: med3 block-at m-hist 0 block-at m-hist 1 block-at m-hist 2
    either > cand m-s [ m-s: + m-s / * 3 - cand m-s 4 ] [ none ]
    m-lat: mt-lat
    m-t: j-now
    track-speed m-s
    adv-next
    bus-alert
]
stops-to-go: func [] [ + 1 - j-alight j-next ]
bus-alert: func [] [
    ts: sv j-alight 0
    either > m-lat c 'alight-lat-m [ lat-n: + lat-n 1 ] [ lat-n: 0 ]
    either < v-cms c 'dwell-cms [ either >= m-s - ts 80 [ either <= m-s + ts 80 [ al-d: 1 ] [ none ] ] [ none ] ] [ none ]
    either >= sp-fast c 'missed-samples [ al-d: 0 ] [ none ]
    either >= lat-n c 'alight-fixes [
        either >= m-s - ts 80 [
            either < v-cms c 'board-cms [ enter-final ] [ none ]
        ] [ none ]
    ] [
        either al-d [ either >= sp-walk c 'alight-walk-n [
            either >= m-s - ts 80 [ enter-final ] [ none ]
        ] [ none ] ] [ none ]
    ]
    either = j-st 'ON_BUS [ bus-alert2 ts ] [ none ]
]
bus-alert2: func [ts] [
    either > j-next j-alight [
        either >= - m-s ts c 'missed-m [
            either >= sp-fast c 'missed-samples [ missed-stop ] [ none ]
        ] [ none ]
    ] [ none ]
    rem: - j-alight j-next
    d: - sv j-alight 0 m-s
    either > rem 0 [
        press-t: -1
        j-alert: either = rem 1 [ 'GET_READY ] [ either <= d c 'ready-m [ 'GET_READY ] [ 'STAY_ON ] ]
    ] [
        either < press-t 0 [ press-t: j-now ] [ none ]
        j-alert: either > d c 'off-m [ 'PRESS_STOP ] [
            either < - j-now press-t c 'press-min-s [ 'PRESS_STOP ] [ 'GET_OFF ]
        ]
    ]
    j-buzz: either = j-alert 'PRESS_STOP [ 2 ] [ either = j-alert 'GET_OFF [ 2 ] [ either = j-alert 'GET_READY [ 1 ] [ 0 ] ] ]
]
missed-stop: func [] [
    j-alight: either < j-next jt-n [ j-next ] [ - jt-n 1 ]
    j-note: 2
    press-t: -1
]
enter-final: func [] [
    j-st: 'WALKING_FINAL
    j-alert: 'NONE
    j-leave: 'NONE
    j-buzz: 0
]
final-update: func [] [
    either <= to-dest-m c 'arrive-m [ j-st: 'ARRIVED  j-buzz: 1 ] [ none ]
]
fix-update: func [] [
    st: j-st
    either = st 'DESTINATION_SELECTED [ plan ] [
    either = st 'JOURNEY_PROPOSED [ pre-board ] [
    either = st 'WALKING_TO_STOP [ walking-update ] [
    either = st 'WAITING_FOR_BUS [ waiting-update ] [
    either = st 'ON_BUS [ bus-update ] [
    either = st 'WALKING_FINAL [ final-update ] [ none ] ] ] ] ] ]
]
time-update: func [] [
    st: j-st
    either = st 'DESTINATION_SELECTED [ plan ] [
    either = st 'JOURNEY_PROPOSED [ pre-board ] [
    either = st 'WALKING_TO_STOP [ pre-board ] [
    either = st 'WAITING_FOR_BUS [ pre-board ] [ none ] ] ] ]
]
reset-journey: func [] [
    j-st: 'IDLE  j-dest: -1  j-opt: -1  j-board: -1  j-alight: -1
    j-alert: 'NONE  j-leave: 'NONE  j-note: 0  j-where: 0  j-walk: 0  j-buzz: 0
    fare-r: 'unknown  fare-ri: -1
    j-q: 0  j-g: 0  j-trip: -1  j-bseq: -1  j-aseq: -1  j-lnow: 0
    jt-n: 0  jw-clear 0  due-t: -100000  w-t: -100000
]
choose: func [k] [
    reset-journey
    either < k dest-n [
        j-dest: k
        either = block-at dest-row * 3 k 0 [ j-note: 5 ] [
            j-dx: block-at dest-row + * 3 k 1
            j-dy: block-at dest-row + * 3 k 2
            j-st: 'DESTINATION_SELECTED
            refresh-geom
            plan
        ]
    ] [ none ]
]
accept: func [] [
    either = j-st 'JOURNEY_PROPOSED [
        either j-walk [ enter-final ] [ j-st: 'WALKING_TO_STOP  walking-update ]
    ] [ none ]
]
board-cmd: func [] [
    either = j-st 'WALKING_TO_STOP [ enter-bus ] [ either = j-st 'WAITING_FOR_BUS [ enter-bus ] [ none ] ]
]
alight-cmd: func [] [ either = j-st 'ON_BUS [ enter-final ] [ none ] ]
]
